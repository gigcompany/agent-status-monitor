# ---------------------------------------------------------------------------
# agent-monitor configuration
#
#   cp .env.example .env   then edit, then run ./install.sh
#
# Read by BOTH the agent-status CLI and the menu bar app, so they can never
# disagree. install.sh copies this to ~/.agent-status/config.env (chmod 600).
#
# Anything here can also be set as a real environment variable, which takes
# precedence - that is how one host reports as several distinct agents.
# ---------------------------------------------------------------------------

# Which backend to use: local | supabase | cosmos
AGENT_STATUS_BACKEND=supabase


# --- local -----------------------------------------------------------------
# No cloud account, no keys, no network. SQLite on this machine, shared by
# every agent running on it. Use this if your agents are all local.
AGENT_STATUS_LOCAL_PATH=~/.agent-status/status.db


# --- supabase (default) ----------------------------------------------------
# Free tier is plenty. Create a project, run backends/supabase/schema.sql in
# the SQL Editor, then paste the values from Project Settings -> API.
AGENT_STATUS_SUPABASE_URL=
AGENT_STATUS_SUPABASE_KEY=
AGENT_STATUS_SUPABASE_TABLE=agent_tasks


# --- cosmos ----------------------------------------------------------------
# Azure Cosmos DB (NoSQL API), serverless recommended.
# install.sh can create the resources for you with: ./install.sh --provision-azure
AGENT_STATUS_COSMOS_ENDPOINT=
AGENT_STATUS_COSMOS_KEY=
AGENT_STATUS_COSMOS_DATABASE=agentmonitor
AGENT_STATUS_COSMOS_CONTAINER=tasks


# --- agent identity --------------------------------------------------------
# Auto-detected from the runtime and hostname when blank. Set these explicitly
# on remote boxes, or when one machine runs several distinct agents.
AGENT_STATUS_AGENT_ID=
AGENT_STATUS_AGENT_LABEL=
AGENT_STATUS_AGENT_KIND=


# --- retention -------------------------------------------------------------
AGENT_STATUS_TTL_HOURS=168
AGENT_STATUS_DONE_TTL_HOURS=48


# --- menu bar app ----------------------------------------------------------
# The local backend is a file read, so it polls fast and free; cloud backends
# cost a request per poll.
AGENT_STATUS_POLL_SECONDS=5
AGENT_STATUS_LOOKBACK_HOURS=12
AGENT_STATUS_NOTIFY_WAITING=true
AGENT_STATUS_NOTIFY_DONE=true
